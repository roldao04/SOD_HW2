# E-Procurement System - Environment Configuration
# ===================================================
#
# DOCKER USAGE (Recommended):
#   - Copy this file to .env (optional, defaults work)
#   - Run: make up
#   - Docker Compose overrides endpoints for internal networking
#
# LOCAL USAGE (Without Docker):
#   - Copy this file to .env
#   - Ensure MinIO/Postgres are running locally
#   - Use localhost endpoints below
#
# ===================================================

# MinIO Configuration
# NOTE: Docker Compose automatically sets MINIO_ENDPOINT=minio:9000 in containers
# These values are for local development outside Docker
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Storage Mode
# Set to "true" to use local filesystem instead of MinIO (for development/testing)
USE_LOCAL_STORAGE=false

# Dremio Configuration
# NOTE: Docker Compose automatically sets DREMIO_HOST=dremio in containers
DREMIO_HOST=localhost
DREMIO_PORT=9047
DREMIO_ARROW_FLIGHT_PORT=32010
