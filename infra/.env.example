# E-Procurement System - Environment Configuration
# ===================================================
#
# SETUP:
#   1. Copy this file to .env: cp infra/.env.example infra/.env
#   2. Update GEMINI_API_KEY with your actual key
#   3. Run: make up
#
# DOCKER USAGE (Recommended):
#   - All variables below are loaded into Docker containers via env_file
#   - DREMIO_HOST is automatically overridden to "dremio" for internal networking
#   - All other values are used as-is from this file
#
# LOCAL USAGE (Without Docker):
#   - Ensure MinIO/Dremio are running locally
#   - Use localhost endpoints below
#
# ===================================================

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Storage Mode
# Set to "true" to use local filesystem instead of MinIO (for development/testing)
USE_LOCAL_STORAGE=false

# Dremio Configuration
# NOTE: DREMIO_HOST is overridden to "dremio" in Docker for internal networking
DREMIO_HOST=localhost
DREMIO_PORT=32010
DREMIO_USERNAME=admin
DREMIO_PASSWORD=password123
DREMIO_TLS=false
DREMIO_TIMEOUT=30

# ===================================================
# NLP Chatbot Configuration
# ===================================================

# Gemini API Configuration
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Query Creator Bot (SQL Generation)
QUERY_CREATOR_MODEL=models/gemini-2.0-flash
QUERY_CREATOR_TEMPERATURE=0.1
QUERY_CREATOR_MAX_TOKENS=1024

# Analytics Bot (Data Analysis)
ANALYTICS_MODEL=models/gemini-2.5-pro
ANALYTICS_TEMPERATURE=0.7
ANALYTICS_MAX_TOKENS=4096

# Query Limits
MAX_QUERY_TIMEOUT=30
MAX_RESULT_ROWS=10000
MAX_JOINS=5
MAX_SUBQUERY_DEPTH=3

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
